{
  "name": "protocolfoundry",
  "version": "0.0.1",
  "private": true,
  "description": "Managed platform that turns authorized applications into eval-tested, hosted MCP servers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
